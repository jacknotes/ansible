# Elasticsearch 后端集群
upstream es_backend {
    least_conn;
    {% for host in groups['elasticsearch'] %}
    server {{ hostvars[host].ansible_host }}:{{ es_http_port }} max_fails=3 fail_timeout=30s;
    {% endfor %}
    
    keepalive 32;
}

# Kibana 后端集群
upstream kibana_backend {
    least_conn;
    {% for host in groups['kibana'] %}
    server {{ hostvars[host].ansible_host }}:{{ kibana_port }} max_fails=3 fail_timeout=30s;
    {% endfor %}
    
    keepalive 32;
}

# default server
server {
        listen 80 default_server;
        return       444;
}

# Elasticsearch 代理服务器
server {
    listen {{ nginx_listen_port }};
    server_name {{ es_domain }};
    
    # 访问日志
    access_log /var/log/nginx/es_access.log main;
    error_log /var/log/nginx/es_error.log;
    
    # 代理设置
    location / {
        proxy_pass http://es_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # 超时设置
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # 缓冲设置
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }
    
    # Nginx 状态检查
    location /stubstatus {
        stub_status;
        access_log off;
    }
    
    # 健康检查端点
    location /nginx-health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }
}

# Kibana 代理服务器
server {
    listen {{ nginx_listen_port }};
    server_name {{ kibana_domain }};
    
    # 访问日志
    access_log /var/log/nginx/kibana_access.log main;
    error_log /var/log/nginx/kibana_error.log;
    
    # 代理设置
    location / {
        proxy_pass http://kibana_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # 超时设置
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # 缓冲设置
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }
    
    # Nginx 状态检查
    location /stubstatus {
        stub_status;
        access_log off;
    }
    
    # 健康检查端点
    location /nginx-health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }
}
