#!/bin/bash
# Keepalived 状态变更通知脚本
# Managed by Ansible - Do not edit manually

STATE=$1
HOSTNAME=$(hostname)
VIP="{{ keepalived_virtual_ip.split('/')[0] }}"
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
LOG_FILE="/var/log/keepalived-notify.log"

log() {
    echo "[$TIMESTAMP] $1" >> "$LOG_FILE"
}

{% if keepalived_dingtalk_enabled | default(false) %}
send_dingtalk() {
    local state=$1
    local title=""
    local content=""
    
    case "$state" in
        master)
            title="VIP 切换告警"
            content="**节点**: ${HOSTNAME}\n**状态**: MASTER\n**VIP**: ${VIP}\n**时间**: ${TIMESTAMP}"
            ;;
        backup)
            title="VIP 状态变更"
            content="**节点**: ${HOSTNAME}\n**状态**: BACKUP\n**VIP**: ${VIP}\n**时间**: ${TIMESTAMP}"
            ;;
        fault)
            title="VIP 故障告警"
            content="**节点**: ${HOSTNAME}\n**状态**: FAULT\n**VIP**: ${VIP}\n**时间**: ${TIMESTAMP}"
            ;;
    esac
    
    curl -s -X POST "{{ keepalived_dingtalk_webhook }}" \
        -H 'Content-Type: application/json' \
        -d "{\"msgtype\":\"markdown\",\"markdown\":{\"title\":\"${title}\",\"text\":\"## ${title}\n\n${content}\"}}" >> "$LOG_FILE" 2>&1
    
    log "Dingtalk sent: ${state}"
}
{% endif %}

{% if keepalived_email_enabled | default(false) %}
send_email() {
    local state=$1
    local subject="[ELK] VIP ${state} - ${HOSTNAME}"
    local body="节点: ${HOSTNAME}\n状态: ${state}\nVIP: ${VIP}\n时间: ${TIMESTAMP}"

    # 跨平台选择发送实现:
    #   s-nail (Debian/Ubuntu)  读取 /etc/s-nail.rc
    #   heirloom-mailx (CentOS7 的 mailx)  读取 /etc/mail.rc
    #   GNU mailutils 两者都不支持（无 -S / 无上述配置），需跳过并提示
    local mailbin base rcfile opts=()
    mailbin="$(command -v s-nail 2>/dev/null || command -v mailx 2>/dev/null || command -v mail 2>/dev/null)"
    if [ -z "$mailbin" ]; then
        log "Email skipped: no mailx implementation found"
        return 1
    fi
    base="$(basename "$mailbin")"

    if "$mailbin" --version 2>/dev/null | grep -qi "GNU Mailutils"; then
        log "Email skipped: GNU mailutils 不支持本脚本所需语法，请安装 s-nail (Debian) 或使用系统自带 mailx (CentOS)"
        return 1
    fi

    case "$base" in
        s-nail) rcfile=/etc/s-nail.rc ;;
        *)      rcfile=/etc/mail.rc ;;
    esac

    if [ -r "$rcfile" ]; then
        # SMTP 配置由 Ansible 部署在系统 rc 文件中
        opts=()
    else
        # 无 rc 配置时回退到内联 -S 语法（CentOS7 heirloom-mailx 实测可用）
        opts=(
            -S "smtp={{ keepalived_email_smtp_server }}:{{ keepalived_email_smtp_port }}"
            -S "smtp-auth=login"
            -S "smtp-auth-user={{ keepalived_email_smtp_user }}"
            -S "smtp-auth-password={{ keepalived_email_smtp_pass }}"
            -S "ssl-verify=ignore"
            -S "sendcharsets=utf-8"
        )
    fi

    if echo -e "$body" | "$mailbin" "${opts[@]}" -s "$subject" -r "{{ keepalived_email_smtp_user }}" "{{ keepalived_email_to }}" >> "$LOG_FILE" 2>&1; then
        log "Email sent: ${state} (via ${base})"
    else
        log "Email FAILED: ${state} (via ${base})"
    fi
}
{% endif %}

log "State change: ${STATE}"

{% if keepalived_dingtalk_enabled | default(false) %}
send_dingtalk "$STATE"
{% endif %}

{% if keepalived_email_enabled | default(false) %}
send_email "$STATE"
{% endif %}

exit 0
