# Mailx SMTP Configuration for Keepalived email notifications
# Managed by Ansible - Do not edit manually
# 按目标系统渲染: RedHat heirloom-mailx → /etc/mail.rc；Debian s-nail → /etc/s-nail.rc
{% if ansible_os_family == 'RedHat' %}
# CentOS 7 自带 mailx (heirloom-mailx) 语法，已在该平台实测可用
set from={{ keepalived_email_smtp_user }}
{% if keepalived_email_smtp_port | int == 465 %}
set smtp=smtps://{{ keepalived_email_smtp_server }}:{{ keepalived_email_smtp_port }}
{% else %}
set smtp={{ keepalived_email_smtp_server }}:{{ keepalived_email_smtp_port }}
{% endif %}
set smtp-auth=login
set smtp-auth-user={{ keepalived_email_smtp_user }}
set smtp-auth-password={{ keepalived_email_smtp_pass }}
set ssl-verify=ignore
set sendcharsets=utf-8
set ttycharset=utf-8
{% else %}
# s-nail (heirloom-mailx 后继) 新式语法：mta URL + v15-compat
# 旧式 smtp/smtp-auth 变量在 s-nail 14.9.24+ 已标记弃用，v15 将移除
# 凭据经 URL 编码，密码含特殊字符也可安全使用

set v15-compat
set from={{ keepalived_email_smtp_user }}
# 强制邮件正文/主题使用 UTF-8 并自动添加 MIME 头；
# 不依赖运行环境 LANG（keepalived 调用时默认 C locale，否则 Foxmail 会按 GBK 解码导致中文乱码）
set ttycharset=utf-8
set sendcharsets=utf-8
{% if keepalived_email_smtp_port | int == 465 %}
# 465 端口为隐式 SSL，必须使用 smtps:// 协议头
set mta=smtps://{{ keepalived_email_smtp_user | urlencode }}:{{ keepalived_email_smtp_pass | urlencode }}@{{ keepalived_email_smtp_server }}:{{ keepalived_email_smtp_port }}
{% else %}
# 25/587 端口，s-nail 在服务器支持时会自动尝试 STARTTLS
set mta=smtp://{{ keepalived_email_smtp_user | urlencode }}:{{ keepalived_email_smtp_pass | urlencode }}@{{ keepalived_email_smtp_server }}:{{ keepalived_email_smtp_port }}
{% endif %}
set tls-verify=ignore
{% endif %}
