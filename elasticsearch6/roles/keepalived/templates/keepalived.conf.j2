! Keepalived Configuration for ELK Cluster
! Managed by Ansible - Do not edit manually

global_defs {
    router_id {{ inventory_hostname }}
    script_user root
    enable_script_security

    # 禁用组播，使用单播更安全
    vrrp_garp_interval 0
    vrrp_gna_interval 0
}

# Nginx + Elasticsearch 健康检查脚本
vrrp_script check_services {
    script "/etc/keepalived/scripts/check_services.sh"
    interval 1
    weight -20
    fall 1
    rise 2
    timeout 3
}

# VRRP 实例配置
vrrp_instance VI_1 {
    state {{ 'MASTER' if inventory_hostname == 'node01' else 'BACKUP' }}
    interface {{ keepalived_interface }}
    virtual_router_id {{ keepalived_virtual_router_id }}

    {% if inventory_hostname == 'node01' %}
    priority {{ keepalived_priority_node01 }}
    {% elif inventory_hostname == 'node02' %}
    priority {{ keepalived_priority_node02 }}
    {% else %}
    priority {{ keepalived_priority_node03 }}
    {% endif %}

    advert_int 1

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }

    # 单播模式配置
    {% if keepalived_unicast | default(true) %}
    unicast_src_ip {{ hostvars[inventory_hostname].ansible_host }}

    unicast_peer {
        {% for host in groups['nginx_nodes'] if host != inventory_hostname %}
        {{ hostvars[host].ansible_host }}
        {% endfor %}
    }
    {% endif %}

    virtual_ipaddress {
        {{ keepalived_virtual_ip }}
    }

    track_script {
        check_services
    }

    # 通知脚本
    {% if (keepalived_dingtalk_enabled | default(false)) or (keepalived_email_enabled | default(false)) %}
    notify_master "/etc/keepalived/scripts/notify.sh master"
    notify_backup "/etc/keepalived/scripts/notify.sh backup"
    notify_fault "/etc/keepalived/scripts/notify.sh fault"
    {% else %}
    notify_master "/bin/echo 'MASTER' > /tmp/keepalived_state"
    notify_backup "/bin/echo 'BACKUP' > /tmp/keepalived_state"
    notify_fault "/bin/echo 'FAULT' > /tmp/keepalived_state"
    {% endif %}
}
