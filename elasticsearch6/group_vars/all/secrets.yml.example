# =============================================================================
# 敏感变量模板文件 - 安全可提交到 Git 仓库
# =============================================================================
# 使用方法：
#   1. 复制此文件为 secrets.yml
#      cp secrets.yml.example secrets.yml
#   2. 编辑 secrets.yml，将占位符替换为真实值
#   3. secrets.yml 已被 .gitignore 排除，不会被提交到仓库
# =============================================================================

# -----------------------------------------------------------------------------
# Keepalived VRRP 认证密码（生产环境请使用强密码，建议 8 位以上随机字符）
# -----------------------------------------------------------------------------
keepalived_auth_pass: "YOUR_KEEPALIVED_AUTH_PASS_HERE"

# -----------------------------------------------------------------------------
# 钉钉 Webhook 通知（可选）
# 创建群组机器人后在钉钉开放平台获取 access_token
# -----------------------------------------------------------------------------
keepalived_dingtalk_enabled: false
keepalived_dingtalk_webhook: "https://oapi.dingtalk.com/robot/send?access_token=YOUR_DINGTALK_ACCESS_TOKEN_HERE"

# -----------------------------------------------------------------------------
# 邮件通知（可选）
# 如需启用邮件通知，请将 keepalived_email_enabled 设为 true
# -----------------------------------------------------------------------------
keepalived_email_enabled: false
keepalived_email_to: "your-email@example.com"                          # 收件人邮箱
keepalived_email_smtp_server: "smtp.example.com"                        # SMTP 服务器地址
keepalived_email_smtp_port: 465                                         # SMTP 端口（SSL 通常为 465）
keepalived_email_smtp_user: "your-smtp-username@example.com"            # SMTP 用户名
keepalived_email_smtp_pass: "YOUR_SMTP_PASSWORD_HERE"                   # SMTP 密码（重要！）

# -----------------------------------------------------------------------------
# Docker 私有仓库 insecure-registries（可选）
# 如果您的内网 harbor 仓库使用 HTTP 协议而非 HTTPS，请在此处添加仓库地址
# 格式: "http://IP:端口" 或 "http://域名"
# -----------------------------------------------------------------------------
docker_insecure_registries:
  - "http://your-harbor-ip:port"       # 替换为您的 harbor 仓库地址
  # - "http://192.168.1.100:8000"       # 示例（请替换为真实地址并取消注释）
