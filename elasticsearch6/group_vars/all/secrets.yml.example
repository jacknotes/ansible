---
# ============================================================
# 机密变量模板：复制为 secrets.yml 并填入真实值（secrets.yml 已被 .gitignore 排除）
#   cp secrets.yml.example secrets.yml
# 规则：本文件中定义的变量以本文件为准，all.yml 中不再重复定义
# ============================================================

# Keepalived VRRP 认证密码
keepalived_auth_pass: "REPLACE_WITH_RANDOM_8CHARS"

# 钉钉告警
keepalived_dingtalk_enabled: false
keepalived_dingtalk_webhook: "https://oapi.dingtalk.com/robot/send?access_token=YOUR_DINGTALK_ACCESS_TOKEN_HERE"

# 邮件告警
keepalived_email_enabled: false
keepalived_email_to: "admin@example.com"
keepalived_email_smtp_server: "smtp.example.com"
keepalived_email_smtp_port: 465
keepalived_email_smtp_user: "alert@example.com"
keepalived_email_smtp_pass: "REPLACE_ME"

# Docker 私有仓库（http 需配置 insecure registries）
docker_insecure_registries:
  - "http://harbor.example.com"
